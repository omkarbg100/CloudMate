# DeployMate Frontend — Environment Variables
# Copy this file to .env (git-ignored).
#
# Both are OPTIONAL. By default the app uses same-origin relative URLs:
#   - API:  /api          (proxied by Vite in dev, nginx in Docker)
#   - WS:   ws(s)://<same host>/ws   (derived from window.location)
# Only set these if the backend runs on a different origin in development.
VITE_API_URL=/api
VITE_WS_URL=
