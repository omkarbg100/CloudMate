# DeployMate AI Engine — Environment Variables

# ── AI Providers (via LangChain) ───────────────────────────────────────────────
# Google Gemini API (primary LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (fast inference, fallback / secondary LLM)
GROQ_API_KEY=your_groq_api_key_here

# Which LangChain provider to use: "gemini" | "groq"
LLM_PROVIDER=gemini

# Gemini model to use
GEMINI_MODEL=gemini-1.5-pro-latest

# Groq model to use (e.g. llama-3.3-70b-versatile, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# LLM sampling temperature
LLM_TEMPERATURE=0.3

# LangGraph retry policy for risky/deploy nodes (max attempts per node)
MAX_RETRIES=3

# Graphviz / Mermaid rendering direction (LR or TB)
GRAPHDIR=LR

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub personal access token for the Repository agent
# (Or user's OAuth token passed per-request from Node backend)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ── Application ───────────────────────────────────────────────────────────────
AI_ENGINE_PORT=8000
NODE_BACKEND_URL=http://localhost:4000

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to use real LangChain model calls. "false" uses rule-based
# fallbacks so the engine runs fully offline (faster for dev).
USE_LLM=false