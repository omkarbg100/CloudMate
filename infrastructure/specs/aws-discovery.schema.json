{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploymate.local/schemas/aws-discovery.schema.json",
  "title": "DeployMateAwsDiscovery",
  "type": "object",
  "required": ["connectionId", "region", "resources"],
  "properties": {
    "connectionId": { "type": "string" },
    "accountId": { "type": "string" },
    "region": { "type": "string" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "service", "name", "region", "summary", "reusable", "riskLevel"],
        "properties": {
          "id": { "type": "string" },
          "service": {
            "enum": ["ECR", "AppRunner", "S3", "RDS", "DynamoDB", "CloudWatch", "VPC", "IAM"]
          },
          "arn": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "tags": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "summary": { "type": "string" },
          "reusable": { "type": "boolean" },
          "riskLevel": { "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
