{
  "version": "0.1",
  "rules": [
    {
      "id": "no-permanent-access-keys",
      "description": "AWS execution must use STS temporary credentials from an IAM role.",
      "effect": "deny",
      "when": {
        "credentialType": ["access_key", "secret_key", "sessionless"]
      }
    },
    {
      "id": "approval-required-for-modify",
      "description": "Modifying existing resources requires explicit approval.",
      "effect": "require_approval",
      "when": {
        "action": ["modify"]
      }
    },
    {
      "id": "approval-required-for-high-risk",
      "description": "High-risk actions require explicit approval.",
      "effect": "require_approval",
      "when": {
        "riskLevel": ["high"]
      }
    },
    {
      "id": "deny-destructive-actions-in-mvp",
      "description": "Delete/replacement actions are not allowed in the MVP executor.",
      "effect": "deny",
      "when": {
        "action": ["delete", "replace"]
      }
    },
    {
      "id": "allow-supported-services",
      "description": "Only explicitly supported AWS services can be targeted.",
      "effect": "allow",
      "when": {
        "service": ["ECR", "AppRunner", "S3", "RDS", "DynamoDB", "CloudWatch", "VPC", "IAM", "SecretsManager", "AgentCore"]
      }
    }
  ]
}
