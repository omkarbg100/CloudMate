# DeployMate Backend — Environment Variables
# Copy this file to .env (git-ignored) and fill in real values.

# Server
BACKEND_PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Python AI engine (use the Docker service name when running via docker compose)
AI_ENGINE_URL=http://localhost:8000

# MongoDB (docker compose sets this to mongodb://mongodb:27017/deploymate)
MONGODB_URI=mongodb://localhost:27017/deploymate

# JWT authentication
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Mark auth cookies Secure. Only set to "true" when serving over HTTPS.
# Keep "false" while running locally over plain http://localhost.
COOKIE_SECURE=false

# GitHub OAuth — leave empty to use the demo login (DEV_DEMO_MODE=true)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/callback

# When true, POST /api/auth/demo creates/uses a demo user (no GitHub needed).
DEV_DEMO_MODE=true
