# === Primary LLM (Local — Ollama) ===
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# === Fallback LLM (Cloud — Google Gemini) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === Budget & Limits ===
MAX_TOTAL_TOKENS=50000
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# === LiteLLM internals ===
LITELLM_LOCAL_MODEL_COST_MAP=True   # skip remote cost-map fetch on startup

# === Server ===
PORT=8000
LOG_LEVEL=INFO

# === Agent Settings ===
REPO_AGENT_MAX_STEPS=15
